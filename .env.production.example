# ==============================================================================
# TỦ SÁCH ÁO LAM — CẤU HÌNH BIẾN MÔI TRƯỜNG PRODUCTION (V1.0)
# HƯỚNG DẪN: Sao chép tệp này thành .env trên máy chủ VPS và điền các giá trị thực tế.
# LƯU Ý BẢO MẬT: TUYỆT ĐỐI KHÔNG commit tệp .env chứa mật khẩu thực tế lên Git.
# ==============================================================================

# 1. Môi trường hệ thống (Bắt buộc thiết lập 'production' để kích hoạt Fail-Fast)
NODE_ENV="production"
APP_ENV="production"
PORT=3000

# 2. Cơ sở dữ liệu PostgreSQL 17 Native (Cổng 5432 cục bộ hoặc trong Docker Network)
# TUYỆT ĐỐI KHÔNG sử dụng 'sentrang_test' hay database có chữ '_test'.
# Định dạng: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]?sslmode=disable
DATABASE_URL="postgresql://tusach_admin:YOUR_STRONG_DB_PASSWORD_HERE@127.0.0.1:5432/sentrang_prod?sslmode=disable"

# 3. Khóa bí mật ký JWT Session (Tạo bằng lệnh: openssl rand -hex 32)
# Độ dài tối thiểu 64 ký tự hex ngẫu nhiên. TUYỆT ĐỐI KHÔNG dùng khóa mặc định.
AUTH_SECRET="REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32"

# 4. Tên miền chính thức của website (HTTPS bắt buộc)
NEXT_PUBLIC_APP_URL="https://tusachaolam.vn"

# 5. Vùng lưu trữ tài sản hình ảnh bền vững (Persistent Volume ngoài source code)
# Đảm bảo tiến trình Node.js có quyền ghi (chown / chmod).
MEDIA_DIR="/var/www/tusachaolam/uploads"

# 6. Cấu hình bảo mật phiên làm việc (Giây) - Mặc định 7 ngày = 604800s
SESSION_MAX_AGE=604800
